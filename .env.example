# ---------- Frontend (exposed to the browser, VITE_ prefix) ----------

# Store Builder Library version
VITE_FS_SBL_URL=https://sbl.onfastspring.com/sbl/1.0.10/fastspring-builder.min.js

# Embedded storefront (from your snippet)
VITE_FS_EMBEDDED_STOREFRONT=tariqh.test.onfastspring.com/embedded-react

# Popup storefront. CHANGE THIS to your real popup storefront path
VITE_FS_POPUP_STOREFRONT=tariqh.test.onfastspring.com/popup-react

# Comma separated product paths used on every page. CHANGE THESE
VITE_FS_PRODUCTS=prod-1,prod-2,prod-3

# Checkout Components URL (Checkouts > Component Checkouts > [checkout] > Implementation)
VITE_FS_COMPONENTS_CHECKOUT_URL=https://tariqh.test.onfastspring.com/components-react

# ---------- Server only (never prefix with VITE_) ----------

API_PORT=4000

# Sessions API checkout path in store-id/checkout-id format
# Check the exact value on the Implementation tab of your Component Checkout
FS_CHECKOUT_PATH=tariqh/components-react

# FastSpring API credentials (Developer Tools > APIs > API Credentials)
# Optional for a basic session, needed for authenticated fields like orderTags
FS_API_USERNAME=
FS_API_PASSWORD=

# Localhost has no public IP so country cannot be inferred. Set a default for local testing
FS_DEFAULT_COUNTRY=IE
