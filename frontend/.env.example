# Store Builder Library version
VITE_FS_SBL_URL=https://sbl.onfastspring.com/sbl/1.0.10/fastspring-builder.min.js

VITE_FS_EMBEDDED_STOREFRONT=tariqh.test.onfastspring.com/embedded-react
VITE_FS_POPUP_STOREFRONT=tariqh.test.onfastspring.com/popup-react

# Comma separated product paths used on every page
VITE_FS_PRODUCTS=prod-1,prod-2,prod-3

# Checkout Components URL (Checkouts > Component Checkouts > [checkout] > Implementation)
VITE_FS_COMPONENTS_CHECKOUT_URL=https://tariqh.test.onfastspring.com/components-react

# Backend base URL. Leave empty locally, Vite proxies /api to localhost:4000
# On Vercel set it to the backend deployment, e.g. https://fastspring-checkouts-api.vercel.app
VITE_API_BASE_URL=
