# Local dev port for server.js (not used on Vercel)
API_PORT=4000

# Sessions API checkout path in store-id/checkout-id format
FS_CHECKOUT_PATH=tariqh/components-react

# FastSpring API credentials (Developer Tools > APIs > API Credentials)
# Set these in Vercel project env vars, never commit them
FS_API_USERNAME=
FS_API_PASSWORD=

# Used when there is no buyer IP to infer country (local dev)
FS_DEFAULT_COUNTRY=IE

# Comma separated frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000
